# ---------- Telegram ----------
BOT_TOKEN=123456:AA...
ADMIN_CHAT_ID=123456789
DB_PATH=/data/bot.db

# ---------- Счёт Bybit ----------
TRADE_ENV=demo
BYBIT_API_KEY=ключ_из_демо_аккаунта
BYBIT_API_SECRET=секрет_из_демо_аккаунта
AUTO_TRADE=1
POSITION_USD=1000
LEVERAGE=10
MARGIN_MODE=cross
MAX_CONCURRENT=4
MAX_SAME_SIDE=3

# ---------- Вход: перелёт от средней ----------
EMA_PERIOD=20
SIGMA_WINDOW=100
ENTRY_SIGMA=2.5
MIN_SIGMA_PCT=0.30
MAX_SIGMA_PCT=3.0
USE_BTC_FILTER=1
BTC_CALM_PCT=0.35
BTC_WINDOW_MIN=15
USE_VOL_FADE=1
VOL_FADE_MAX=0.70
IMPULSE_LOOKBACK=6

# ---------- Выход ----------
# TP и SL у каждой сделки свои: считаются от величины перелёта.
TP_FRACTION=0.60
SL_SIGMA=0.9
MIN_TP_PCT=0.45
MAX_SL_PCT=2.5
MIN_RR=1.10
TIME_STOP_MIN=90
FEE_TAKER=0.055
FEE_MAKER=0.020

# ---------- Сканер ----------
TIMEFRAME=5
CANDLES=150
SCAN_INTERVAL=30
SYNC_INTERVAL=15
BATCH_SIZE=45
COOLDOWN_MIN=45
MIN_TURNOVER=10000000
MAX_SPREAD_PCT=0.06
MIN_AGE_DAYS=30
BLACKLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,TRXUSDT,LTCUSDT,LINKUSDT

# ---------- Уведомления ----------
NOTIFY_BLOCKED=0
ERROR_ALERT_AFTER=20
ERROR_ALERT_COOLDOWN_MIN=60
